datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x", "linux-musl-openssl-3.0.x"]
}

enum AppStatus {
  DEVELOPMENT
  PRODUCTION
  DISABLED
}

enum AttemptState {
  INITIATED
  WAITING_FOR_WHATSAPP
  PROCESSING
  VERIFIED
  LOGIN_LINK_CONSUMED
  COMPLETED
  EXPIRED
  FAILED
  REJECTED
}

enum WhatsAppConnectionStatus {
  DISCONNECTED
  INITIALIZING
  QR_READY
  AUTHENTICATED
  CONNECTED
  FAILED
}

model Application {
  id                 String               @id @default(uuid())
  name               String
  clientId           String               @unique @map("client_id")
  clientSecretHash   String               @map("client_secret_hash")
  authServerUrl      String?              @map("auth_server_url")
  redirectUris       String[]             @map("redirect_uris")
  webhookUrl         String?              @map("webhook_url")
  status             AppStatus            @default(DEVELOPMENT)
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  
  authAttempts       AuthAttempt[]
  authorizationCodes AuthorizationCode[]
  userSessions       UserSession[]
  auditLogs          AuditLog[]

  @@map("applications")
}

model User {
  id                 String               @id @default(uuid())
  phoneNumber        String               @unique @map("phone_number")
  fullName           String?              @map("full_name")
  email              String?              @map("email")
  countryCode        String?              @map("country_code")
  isVerified         Boolean              @default(true) @map("is_verified")
  status             String               @default("ACTIVE")
  lastLoginAt        DateTime?            @map("last_login_at")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  authAttempts       AuthAttempt[]
  authorizationCodes AuthorizationCode[]
  userSessions       UserSession[]

  @@map("users")
}

model AuthAttempt {
  id                  String               @id @default(uuid())
  applicationId       String               @map("application_id")
  userId              String?              @map("user_id")
  phoneNumber         String               @map("phone_number")
  fullName            String?              @map("full_name")
  email               String?              @map("email")
  challengeHash       String               @map("challenge_hash")
  challengePrefix     String               @default("AUTH") @map("challenge_prefix")
  state               AttemptState         @default(INITIATED)
  ipAddress           String?              @map("ip_address")
  userAgent           String?              @map("user_agent")
  redirectUri         String               @map("redirect_uri")
  stateParam          String?              @map("state_param")
  codeChallenge       String?              @map("code_challenge")
  codeChallengeMethod String?              @default("S256") @map("code_challenge_method")
  failedAttempts      Int                  @default(0) @map("failed_attempts")
  expiresAt           DateTime             @map("expires_at")
  verifiedAt          DateTime?            @map("verified_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  application         Application          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user                User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  loginTokens         LoginToken[]
  authorizationCodes  AuthorizationCode[]

  @@index([phoneNumber, state])
  @@index([challengeHash])
  @@index([applicationId])
  @@map("auth_attempts")
}

model LoginToken {
  id            String      @id @default(uuid())
  authAttemptId String      @map("auth_attempt_id")
  tokenHash     String      @unique @map("token_hash")
  expiresAt     DateTime    @map("expires_at")
  consumedAt    DateTime?   @map("consumed_at")
  createdAt     DateTime    @default(now()) @map("created_at")

  authAttempt   AuthAttempt @relation(fields: [authAttemptId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("login_tokens")
}

model AuthorizationCode {
  id            String      @id @default(uuid())
  authAttemptId String      @map("auth_attempt_id")
  applicationId String      @map("application_id")
  userId        String      @map("user_id")
  codeHash      String      @unique @map("code_hash")
  redirectUri   String      @map("redirect_uri")
  expiresAt     DateTime    @map("expires_at")
  consumedAt    DateTime?   @map("consumed_at")
  createdAt     DateTime    @default(now()) @map("created_at")

  authAttempt   AuthAttempt @relation(fields: [authAttemptId], references: [id], onDelete: Cascade)
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([codeHash])
  @@map("authorization_codes")
}

model UserSession {
  id            String      @id @default(uuid())
  userId        String      @map("user_id")
  applicationId String      @map("application_id")
  sessionToken  String      @unique @map("session_token")
  ipAddress     String?     @map("ip_address")
  userAgent     String?     @map("user_agent")
  expiresAt     DateTime    @map("expires_at")
  revokedAt     DateTime?   @map("revoked_at")
  createdAt     DateTime    @default(now()) @map("created_at")

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model WhatsAppSession {
  id             String                   @id @default(uuid())
  sessionName    String                   @unique @map("session_name")
  status         WhatsAppConnectionStatus @default(DISCONNECTED)
  phoneNumber    String?                  @map("phone_number")
  qrCode         String?                  @db.Text @map("qr_code")
  platform       String?                  @map("platform")
  lastActiveAt   DateTime?                @map("last_active_at")
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")

  @@map("whatsapp_sessions")
}

model AuditLog {
  id            String       @id @default(uuid())
  applicationId String?      @map("application_id")
  eventType     String       @map("event_type")
  ipAddress     String?      @map("ip_address")
  details       Json?        @map("details")
  createdAt     DateTime     @default(now()) @map("created_at")

  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([eventType, createdAt])
  @@map("audit_logs")
}

model SystemSetting {
  key         String   @id
  value       String   @db.Text
  isEncrypted Boolean  @default(false) @map("is_encrypted")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}
