# ==============================================================================
# WhatsApp Auth Example Consumer Application - Environment Template
# ==============================================================================

# Application Server Port
EXAMPLE_APP_PORT=5000

# WhatsApp Auth Core Server URL
# Local: http://localhost:4000 | Production: https://auth.example.com
AUTH_API_URL=http://localhost:4000

# Registered OAuth 2.0 Client Credentials (from Dashboard -> Applications)
AUTH_CLIENT_ID=wa_client_your_client_id_here
AUTH_CLIENT_SECRET=wa_sec_your_client_secret_here

# Whitelisted OAuth Callback URL
REDIRECT_URI=http://localhost:5000/auth/callback

# Default Form Placeholders (Optional)
DEFAULT_FULL_NAME=John Doe
DEFAULT_EMAIL=user@example.com
DEFAULT_PHONE=+14155552671
