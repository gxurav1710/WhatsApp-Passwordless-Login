FROM node:20-alpine AS builder
WORKDIR /app

COPY package.json pnpm-workspace.yaml* package-lock.json* ./
COPY packages/ ./packages/
COPY apps/dashboard/ ./apps/dashboard/
COPY tsconfig.base.json ./

RUN npm install --include=dev
RUN npm --workspace=@whatsapp-auth/protocol run build
RUN npm --workspace=@whatsapp-auth/dashboard run build

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000

COPY --from=builder /app ./

EXPOSE 3000
CMD ["npm", "--workspace=@whatsapp-auth/dashboard", "run", "start"]
