FROM node:20-bullseye-slim AS builder
WORKDIR /app

# Install dependencies and build
COPY package.json pnpm-workspace.yaml* package-lock.json* ./
COPY packages/ ./packages/
COPY apps/whatsapp-worker/ ./apps/whatsapp-worker/
COPY tsconfig.base.json ./

RUN npm install --include=dev
RUN npm --workspace=@whatsapp-auth/protocol run build
RUN npm --workspace=@whatsapp-auth/security run build
RUN npm --workspace=@whatsapp-auth/whatsapp-worker run build

FROM node:20-bullseye-slim AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV WORKER_PORT=4001

COPY --from=builder /app ./

# Create directory for persistent Baileys WhatsApp auth session
RUN mkdir -p /app/apps/whatsapp-worker/.baileys_auth

EXPOSE 4001
CMD ["node", "apps/whatsapp-worker/dist/index.js"]
