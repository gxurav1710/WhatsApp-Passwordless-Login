FROM node:20-bullseye-slim AS builder
WORKDIR /app

RUN apt-get update && apt-get install -y openssl ca-certificates && rm -rf /var/lib/apt/lists/*

# Install dependencies and build monorepo packages
COPY package.json pnpm-workspace.yaml* package-lock.json* ./
COPY packages/ ./packages/
COPY apps/api/ ./apps/api/
COPY tsconfig.base.json ./

RUN npm install --include=dev
RUN npm --workspace=@whatsapp-auth/protocol run build
RUN npm --workspace=@whatsapp-auth/security run build
RUN npm --workspace=@whatsapp-auth/core run build
RUN npm --workspace=@whatsapp-auth/db run prisma:generate
RUN npm --workspace=@whatsapp-auth/db run build
RUN npm --workspace=@whatsapp-auth/api run build

FROM node:20-bullseye-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=4000

RUN apt-get update && apt-get install -y openssl ca-certificates && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app ./

EXPOSE 4000
CMD ["node", "apps/api/dist/index.js"]
