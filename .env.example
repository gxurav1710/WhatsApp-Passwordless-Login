# ==============================================================================
# WhatsApp Authentication Platform - Environment Configuration Template
# ==============================================================================

# Node Environment ('development' or 'production')
NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. Auth Core API Configuration (apps/api)
# ------------------------------------------------------------------------------
PORT=4000
HOST=0.0.0.0

# Public URL of the Auth Server (used for token links and callbacks)
# Local: http://localhost:4000 | Production: https://auth.example.com
APP_URL=http://localhost:4000

# Dashboard URL for CORS configuration
DASHBOARD_URL=http://localhost:3000

# PostgreSQL Database Connection URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whatsapp_auth?schema=public

# ------------------------------------------------------------------------------
# 2. Cryptographic & Security Secrets (CHANGE THESE IN PRODUCTION)
# ------------------------------------------------------------------------------
# Master API Key protecting /api/v1/admin/* endpoints
ADMIN_API_KEY=admin_super_secret_key_change_me_in_prod_12345

# Secret used to sign session access tokens
SESSION_SECRET=session_secret_key_change_me_in_prod_67890

# Internal bearer secret for API <-> WhatsApp Worker Daemon communication
WORKER_INTERNAL_SECRET=worker_secret_key_change_me_in_prod_abcde

# ------------------------------------------------------------------------------
# 3. WhatsApp Worker Configuration (apps/whatsapp-worker)
# ------------------------------------------------------------------------------
WORKER_PORT=4001
WORKER_URL=http://localhost:4001
AUTH_API_URL=http://localhost:4000

# Transport Adapter: 'baileys' (production WebSockets) or 'mock' (offline testing)
WHATSAPP_ADAPTER=baileys

# Path for persistent Baileys multi-device encryption keys
WHATSAPP_SESSION_PATH=./.baileys_auth

# Bot phone number fallback (auto-discovered on WhatsApp QR connection)
WHATSAPP_BOT_PHONE=+14155550199

# ------------------------------------------------------------------------------
# 4. Challenge & Token Lifespans (Seconds)
# ------------------------------------------------------------------------------
CHALLENGE_TTL_SECONDS=300
LOGIN_TOKEN_TTL_SECONDS=120
AUTH_CODE_TTL_SECONDS=60
CHALLENGE_PREFIX=AUTH

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS_PER_WINDOW=100
RATE_LIMIT_WINDOW_MS=60000

# ------------------------------------------------------------------------------
# 5. Developer Dashboard Configuration (apps/dashboard)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3000
